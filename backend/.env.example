# Copy to .env (never commit it) or set these in your hosting provider's secret settings.
PORT=8787
# mock = deterministic responses for local testing; anthropic = real model
AI_PROVIDER=mock
ANTHROPIC_API_KEY=<your-anthropic-api-key>
AI_MODEL=claude-sonnet-5-5
# Optional: require this bearer token from the app (set the same value as AI_APP_TOKEN in local.properties)
APP_SHARED_TOKEN=<random-string>
RATE_LIMIT_PER_MINUTE=20
UPSTREAM_TIMEOUT_MS=30000
